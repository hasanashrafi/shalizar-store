# Database
MONGODB_URI="mongodb+srv://your-username:your-password@cluster0.yourcluster.mongodb.net/your-db-name?retryWrites=true&w=majority"

# Admin credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-password-here"
