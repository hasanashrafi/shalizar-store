# Customer session
USER_SESSION_SECRET="your-user-session-secret-min-32-chars-long"

# Seed data
SEED_SECRET="your-seed-secret-change-in-production"

# Public config
NEXT_PUBLIC_BUSINESS_PHONE="02112345678"
NEXT_PUBLIC_WAREHOUSE_ADDRESS="تهران، خیابان ولیعصر، پلاک ۱۲۳"